GOOGLE_API_KEY=tu_api_key_de_gemini_aqui
ANTHROPIC_API_KEY=tu_api_key_de_anthropic_aqui
PORT=3000

# Meta Marketing API (extracción de copys de anuncios, solo lectura)
META_ACCESS_TOKEN=tu_token_de_meta_aqui
# META_API_VERSION=v25.0

# Login con Google, restringido a un dominio (ver README > "Login con
# Google"). Mientras estas dos no estén puestas, el server NO pide login --
# sigue funcionando abierto, como antes.
# GOOGLE_OAUTH_CLIENT_ID=tu_client_id_de_google_cloud_aqui
# GOOGLE_OAUTH_CLIENT_SECRET=tu_client_secret_de_google_cloud_aqui
# ALLOWED_EMAIL_DOMAIN=benandfrank.com
# PUBLIC_SERVER_URL=https://topito-server.onrender.com

# Opcional: sobreescribir los modelos por defecto
# GEMINI_MODEL_FAST=gemini-2.5-flash-lite
# CLAUDE_MODEL_REESCRIBIR=claude-sonnet-5
# CLAUDE_MODEL_GENERATE=claude-sonnet-5

# Bot de Slack "Topito" (ver README > "Bot de Slack"). Mientras estas dos no
# estén puestas, el bot queda desactivado y el resto del server no cambia.
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_SIGNING_SECRET=...
# Opcionales:
# SLACK_ALLOWED_TEAM_ID=T0123456       # aceptar solo este workspace
# SLACK_ADMIN_USER_IDS=U0123,U0456     # quién puede ver el reporte de uso (vacío = todos los del dominio)
# SLACK_RATE_LIMIT=30                  # peticiones de IA por usuario cada 10 min
# CLAUDE_MODEL_SLACK_ROUTER=claude-haiku-4-5-20251001

# Persistencia (ver storage.mjs). Sin estas variables se usan archivos locales
# (que Render borra en cada deploy).
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SERVICE_KEY=sb_secret_...        # solo en el server
# TOPITO_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/.../exec
# TOPITO_SHEET_SECRET=...                   # lo genera configurarTopito() en apps-script/Code.gs
