# Dependencies
node_modules/

# Environment variables (contiene la API key, nunca se sube)
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*

# OS
.DS_Store

# Registro de uso/costo de las llamadas a la IA (datos operativos, no código)
usage-log.jsonl

# Feedback (likes/neutral/bad) sobre las opciones generadas por IA (datos operativos)
feedback-log.jsonl

# (tuning-embeddings.json SÍ se sube a git a propósito: es lo que Render necesita
# para tener la selección de referencia por relevancia en producción. El workflow
# semanal de GitHub Actions lo recalcula y lo comitea junto con tuning.json.)

# Formato VIEJO del estado de paginación de fetch-meta-ads.mjs -- contiene el
# META_ACCESS_TOKEN embebido, nunca se debe subir a git. El formato nuevo
# (.meta-ads-progress.json) va sin token y SÍ se sube, para que GitHub Actions
# retome el backfill donde se quedó.
.meta-ads-state.json

# Sesiones activas del login con Google (contiene tokens de sesión, no se sube)
data/sessions.json
Claude outputs/
data/slack-prefs.json
